# /etc/systemd/system/baby-calculator.service
[Unit]
Description=Gunicorn instance to serve baby-calculator
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/bc.luka-pejakovic.from.hr/baby-calculator
Environment="PATH=/var/www/bc.luka-pejakovic.from.hr/baby-calculator/bc-env/bin"
# Creates /run/baby-calculator owned by www-data; nginx connects to the socket there
RuntimeDirectory=baby-calculator
ExecStart=/var/www/bc.luka-pejakovic.from.hr/baby-calculator/bc-env/bin/gunicorn --workers 1 --bind unix:/run/baby-calculator/bc-calculator.sock -m 007 --no-control-socket wsgi:app
Restart=on-failure

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
